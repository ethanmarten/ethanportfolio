{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.emstudios.tech"
        }
      ],
      "destination": "https://emstudios.tech/:path*",
      "permanent": true
    },
    {
      "source": "/ethanmarten",
      "destination": "/ehabalhayek/",
      "permanent": true
    },
    {
      "source": "/ethanmarten/:path*",
      "destination": "/ehabalhayek/:path*",
      "permanent": true
    },
    {
      "source": "/ehabalhayek",
      "destination": "/ehabalhayek/",
      "permanent": true
    },
    {
      "source": "/favicon.ico",
      "destination": "/assets/em-studios-icon.png",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/ehabalhayek/assets/:path*",
      "destination": "/assets/:path*"
    },
    {
      "source": "/ehabalhayek/favicon.png",
      "destination": "/ehab-favicon.png"
    },
    {
      "source": "/ehabalhayek/ehab-alhayek-cv.pdf",
      "destination": "/ehab-alhayek-cv.pdf"
    },
    {
      "source": "/",
      "destination": "https://em-studios-gamma.vercel.app/"
    },
    {
      "source": "/assets/:path*",
      "destination": "https://em-studios-gamma.vercel.app/assets/:path*"
    },
    {
      "source": "/styles.css",
      "destination": "https://em-studios-gamma.vercel.app/styles.css"
    },
    {
      "source": "/app.js",
      "destination": "https://em-studios-gamma.vercel.app/app.js"
    },
    {
      "source": "/favicon.svg",
      "destination": "https://em-studios-gamma.vercel.app/favicon.svg"
    },
    {
      "source": "/studio.js",
      "destination": "https://em-studios-gamma.vercel.app/studio.js"
    },
    {
      "source": "/translations.json",
      "destination": "https://em-studios-gamma.vercel.app/translations.json"
    },
    {
      "source": "/services/:path*",
      "destination": "https://em-studios-gamma.vercel.app/services/:path*"
    }
  ],
  "headers": [
    {
      "source": "/ehab-alhayek-cv.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    },
    {
      "source": "/ehabalhayek/ehab-alhayek-cv.pdf",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, noarchive"
        }
      ]
    }
  ]
}
